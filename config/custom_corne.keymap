#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    combos {
        compatible = "zmk,combos";

        gaming_toggle {
            bindings = <&tog 2>;
            key-positions = <53 5 0>;
        };

        Gallium_toggle {
            bindings = <&tog 1>;
            key-positions = <54 6 11>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------------------------------------------
            // | ESC |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | DEL |
            // | TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U  |  I  |  O  |  P  |  \  |
            // | SHFT|  A  |  S  |  D  |  F  |  G  |   |  H  |  J  |  K  |  L  |  ;  |  '  |
            // | CTRL|  Z  |  X  |  C  |  V  |  B  |   |  N  |  M  |  ,  |  .  |  /  | ENT |
            //                    | ALT | BSPC| NUM |   | NAV | SPC | WIN|

            bindings = <
&kp ESC    &kp N1  &kp N2  &kp N3    &kp N4    &kp N5  &kp N6  &kp N7     &kp N8     &kp N9   &kp N0    &kp DEL
&kp TAB    &kp Q   &kp W   &kp E     &kp R     &kp T   &kp Y   &kp U      &kp I      &kp O    &kp P     &kp MINUS
&kp LSHFT  &kp A   &kp S   &kp D     &kp F     &kp G   &kp H   &kp J      &kp K      &kp L    &kp SEMI  &kp SQT
&kp LCTRL  &kp Z   &kp X   &kp C     &kp V     &kp B   &kp N   &kp M      &kp COMMA  &kp DOT  &kp FSLH  &kp RET
&none      &none   &none   &kp LALT  &kp BSPC  &mo 3   &mo 5   &kp SPACE  &kp LGUI   &none    &none     &none
            >;
        };

        gallium_layer {
            // -----------------------------------------------------------------------------------------
            // | ESC |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | DEL |
            // | TAB |  B  |  L  |  D  |  C  |  V  |   |  J  |  Y  |  O  |  U  |  '  |  \  |
            // | SHFT|  N  |  R  |  T  |  S  |  G  |   |  P  |  H  |  A  |  E  |  I  |  ;  |
            // | CTRL|  X  |  Q  |  M  |  W  |  Z  |   |  K  |  F  |  ,  |  .  |  /  | ENT |
            //                   | ALT | BSPC| NUM |   | NAV | SPC | WIN|

            bindings = <
&kp ESC    &kp N1  &kp N2  &kp N3    &kp N4    &kp N5  &kp N6  &kp N7     &kp N8     &kp N9   &kp N0    &kp DEL
&kp TAB    &kp B   &kp L   &kp D     &kp C     &kp V   &kp J   &kp Y      &kp O      &kp U    &kp SQT   &kp MINUS
&kp LSHFT  &kp N   &kp R   &kp T     &kp S     &kp G   &kp P   &kp H      &kp A      &kp E    &kp I     &kp SEMI
&kp LCTRL  &kp X   &kp Q   &kp M     &kp W     &kp Z   &kp K   &kp F      &kp COMMA  &kp DOT  &kp FSLH  &kp RET
&none      &none   &none   &kp LALT  &kp BSPC  &mo 3   &mo 6   &kp SPACE  &kp LGUI   &none    &none     &none
            >;
        };

        GAMING_LAYER {
            bindings = <
&kp ESC    &kp N1  &kp N2  &kp N3  &kp N4     &kp N5  &trans  &trans  &trans  &trans  &trans  &trans
&kp TAB    &kp N6  &kp Q   &kp W   &kp E      &kp R   &trans  &trans  &trans  &trans  &trans  &trans
&kp LSHFT  &kp N7  &kp A   &kp S   &kp D      &kp F   &trans  &trans  &trans  &trans  &trans  &trans
&kp LCTRL  &kp N8  &kp Z   &kp X   &kp C      &kp V   &trans  &trans  &trans  &trans  &trans  &trans
&trans     &trans  &trans  &trans  &kp SPACE  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        num_layer {
            // -----------------------------------------------------------------------------------------
            // |  F1 |  F2 |  F3 |  F4 |  F5 |  F6 |   |  F7 |  F8 |  F9 | F10 | F11 | F12 |
            // |     |     |     |     |     |     |   |  /  |  7  |  8  |  9  |  -  |     |
            // |     |     |     |     |     |     |   |  * |  4  |  5  |  6  |  +  |     |
            // |     |     |     |     |     |     |   |  0  |  1  |  2  |  3  |  .  | ENT |
            //                   | GAL |     | NAV |   | QWER|     |     |

            bindings = <
&kp F1        &kp F2  &kp F3    &kp F4        &kp F5     &kp F6         &kp F7        &kp F8  &kp F9         &kp F10  &kp F11    &kp F12
&trans        &trans  &trans    &kp UP_ARROW  &trans     &kp PAGE_UP    &trans        &kp N7  &kp N8         &kp N9   &kp PLUS   &trans
&kp CAPSLOCK  &trans  &kp LEFT  &kp DOWN      &kp RIGHT  &kp PAGE_DOWN  &kp ASTERISK  &kp N4  &kp N5         &kp N6   &kp PLUS   &kp EQUAL
&trans        &trans  &trans    &trans        &trans     &trans         &kp N0        &kp N1  &kp N2         &kp N3   &kp SLASH  &kp RET
&none         &none   &none     &tog 4        &trans     &trans         &trans        &trans  &kp RIGHT_ALT  &none    &none      &none
            >;
        };

        TOGGLE_NUM {
            bindings = <
&kp F1        &kp F2  &kp F3    &kp F4        &kp F5     &kp F6         &kp F7        &kp F8  &kp F9         &kp F10  &kp F11    &kp F12
&trans        &trans  &trans    &kp UP_ARROW  &trans     &kp PAGE_UP    &trans        &kp N7  &kp N8         &kp N9   &kp PLUS   &trans
&kp CAPSLOCK  &trans  &kp LEFT  &kp DOWN      &kp RIGHT  &kp PAGE_DOWN  &kp ASTERISK  &kp N4  &kp N5         &kp N6   &kp PLUS   &kp EQUAL
&trans        &trans  &trans    &trans        &trans     &trans         &kp N0        &kp N1  &kp N2         &kp N3   &kp SLASH  &kp RET
&none         &none   &none     &tog 4        &trans     &trans         &trans        &trans  &kp RIGHT_ALT  &none    &none      &none
            >;
        };

        nav_layer {
            // -----------------------------------------------------------------------------------------
            // |      |     |     |     |     |     |   |     |     |     |     |     | DEL |
            // |      |     |     |     |     |     |   |     |     |  UP |     |     |     |
            // |      |     |     |     |     |     |   |     | LF  |  DN | RT  |     |     |
            // |      |     |     |     |     |     |   |     |     |     |     |     |     |
            //                    | GAL |     | QWER|   | NUM |     |     |

            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &kp PRINTSCREEN  &trans      &trans    &trans      &trans  &kp DEL
&trans  &trans  &trans  &trans  &trans  &trans  &kp PAGE_UP      &kp HOME    &kp UP    &kp END     &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &kp PAGE_DOWN    &kp LEFT    &kp DOWN  &kp RIGHT   &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans           &kp C_PREV  &kp C_PP  &kp C_NEXT  &trans  &trans
&none   &none   &none   &trans  &trans  &trans  &trans           &trans      &tog 6    &none       &none   &none
            >;
        };

        TOGGLE_NAV {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &kp PRINTSCREEN  &trans      &trans    &trans      &trans  &kp DEL
&trans  &trans  &trans  &trans  &trans  &trans  &kp PAGE_UP      &kp HOME    &kp UP    &kp END     &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &kp PAGE_DOWN    &kp LEFT    &kp DOWN  &kp RIGHT   &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans           &kp C_PREV  &kp C_PP  &kp C_NEXT  &trans  &trans
&none   &none   &none   &trans  &trans  &trans  &trans           &trans      &tog 6    &none       &none   &none
            >;
        };
    };
};
